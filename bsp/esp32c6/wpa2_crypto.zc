// ZenRTOS Freestanding WPA2-PSK Cryptographic Primitives in Zen-C
// Implements SHA-1 (FIPS 180-4), HMAC-SHA1 (RFC 2104), PBKDF2-SHA1 (RFC 2898 / IEEE 802.11i),
// IEEE 802.11i PRF-384, and RFC 3394 AES-128 Key Unwrap.
// Portable across both ESP32-C6 target and Linux host unit tests.

// Freestanding byte helpers (no <string.h> dependency on host or target)
fn mem_copy(dst: u8*, src: u8*, n: usize) {
    let i: usize = 0;
    while i < n {
        dst[i] = src[i];
        i = i + 1;
    }
}

fn mem_zero(dst: u8*, n: usize) {
    let i: usize = 0;
    while i < n {
        dst[i] = (u8)0;
        i = i + 1;
    }
}

fn str_len(s: char*) -> usize {
    let n: usize = 0;
    while s[n] != '\0' {
        n = n + 1;
    }
    return n;
}

// ===========================================================================
// 1. SHA-1 & HMAC-SHA1 (FIPS 180-4 / RFC 2104)
// ===========================================================================
struct Sha1Ctx {
    state: u32[5];
    bitcount: u64;
    buf: u8[64];
}

@inline
fn rol32(v: u32, n: u32) -> u32 {
    return (v << n) | (v >> (32 - n));
}

@inline
fn be32_load(p: u8*) -> u32 {
    return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | (u32)p[3];
}

@inline
fn be32_store(p: u8*, v: u32) {
    p[0] = (u8)(v >> 24);
    p[1] = (u8)(v >> 16);
    p[2] = (u8)(v >> 8);
    p[3] = (u8)(v & 0xFF);
}

fn sha1_transform(state: u32*, block: u8*) {
    let w: u32[80];
    let i: u32 = 0;
    while i < 16 {
        w[i] = be32_load(&block[i * 4]);
        i = i + 1;
    }
    i = 16;
    while i < 80 {
        w[i] = rol32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
        i = i + 1;
    }

    let a: u32 = state[0];
    let b: u32 = state[1];
    let c: u32 = state[2];
    let d: u32 = state[3];
    let e: u32 = state[4];

    i = 0;
    while i < 80 {
        let f: u32 = 0;
        let k: u32 = 0;
        if i < 20 {
            f = (b & c) | ((~b) & d);
            k = (u32)0x5A827999;
        } else if i < 40 {
            f = b ^ c ^ d;
            k = (u32)0x6ED9EBA1;
        } else if i < 60 {
            f = (b & c) | (b & d) | (c & d);
            k = (u32)0x8F1BBCDC;
        } else {
            f = b ^ c ^ d;
            k = (u32)0xCA62C1D6;
        }
        let tmp: u32 = rol32(a, 5) + f + e + k + w[i];
        e = d;
        d = c;
        c = rol32(b, 30);
        b = a;
        a = tmp;
        i = i + 1;
    }

    state[0] = state[0] + a;
    state[1] = state[1] + b;
    state[2] = state[2] + c;
    state[3] = state[3] + d;
    state[4] = state[4] + e;
}

fn sha1_init(ctx: Sha1Ctx*) {
    ctx.state[0] = (u32)0x67452301;
    ctx.state[1] = (u32)0xEFCDAB89;
    ctx.state[2] = (u32)0x98BADCFE;
    ctx.state[3] = (u32)0x10325476;
    ctx.state[4] = (u32)0xC3D2E1F0;
    ctx.bitcount = 0;
}

fn sha1_update(ctx: Sha1Ctx*, data: u8*, len: usize) {
    let idx: usize = (usize)((ctx.bitcount >> 3) & 63);
    ctx.bitcount = ctx.bitcount + ((u64)len << 3);
    let i: usize = 0;
    if idx > 0 {
        let fill: usize = 64 - idx;
        if len < fill {
            mem_copy(&ctx.buf[idx], data, len);
            return;
        }
        mem_copy(&ctx.buf[idx], data, fill);
        sha1_transform(&ctx.state[0], &ctx.buf[0]);
        i = i + fill;
    }
    while i + 64 <= len {
        sha1_transform(&ctx.state[0], &data[i]);
        i = i + 64;
    }
    if i < len {
        mem_copy(&ctx.buf[0], &data[i], len - i);
    }
}

fn sha1_final(ctx: Sha1Ctx*, digest: u8*) {
    let bits: u64 = ctx.bitcount;
    let pad: u8 = 0x80;
    sha1_update(ctx, &pad, 1);
    let zero: u8 = 0;
    while ((ctx.bitcount >> 3) & 63) != 56 {
        sha1_update(ctx, &zero, 1);
    }
    let len_be: u8[8];
    be32_store(&len_be[0], (u32)(bits >> 32));
    be32_store(&len_be[4], (u32)(bits & 0xFFFFFFFF));
    sha1_update(ctx, &len_be[0], 8);
    let i: u32 = 0;
    while i < 5 {
        be32_store(&digest[i * 4], ctx.state[i]);
        i = i + 1;
    }
}

@used
fn wpa2_sha1_vec(num_elem: usize, addr: u8**, len: usize*, mac: u8*) {
    let ctx: Sha1Ctx;
    sha1_init(&ctx);
    let i: usize = 0;
    while i < num_elem {
        if addr[i] != (u8*)0 && len[i] > 0 {
            sha1_update(&ctx, addr[i], len[i]);
        }
        i = i + 1;
    }
    sha1_final(&ctx, mac);
}

@used
fn wpa2_hmac_sha1_vec(key: u8*, key_len: usize,
                      num_elem: usize, addr: u8**, len: usize*,
                      mac: u8*) {
    let k_pad: u8[64];
    let tk: u8[20];
    let use_key: u8* = key;
    let use_len: usize = key_len;

    if use_len > 64 {
        let ka: u8*[1];
        let kl: usize[1];
        ka[0] = use_key;
        kl[0] = use_len;
        wpa2_sha1_vec(1, &ka[0], &kl[0], &tk[0]);
        use_key = &tk[0];
        use_len = 20;
    }

    mem_zero(&k_pad[0], 64);
    mem_copy(&k_pad[0], use_key, use_len);
    let i: u32 = 0;
    while i < 64 {
        k_pad[i] = k_pad[i] ^ (u8)0x36;
        i = i + 1;
    }

    let ctx: Sha1Ctx;
    sha1_init(&ctx);
    sha1_update(&ctx, &k_pad[0], 64);
    let idx: usize = 0;
    while idx < num_elem {
        if addr[idx] != (u8*)0 && len[idx] > 0 {
            sha1_update(&ctx, addr[idx], len[idx]);
        }
        idx = idx + 1;
    }
    let inner: u8[20];
    sha1_final(&ctx, &inner[0]);

    mem_zero(&k_pad[0], 64);
    mem_copy(&k_pad[0], use_key, use_len);
    i = 0;
    while i < 64 {
        k_pad[i] = k_pad[i] ^ (u8)0x5C;
        i = i + 1;
    }

    sha1_init(&ctx);
    sha1_update(&ctx, &k_pad[0], 64);
    sha1_update(&ctx, &inner[0], 20);
    sha1_final(&ctx, mac);
}

@used
fn wpa2_hmac_sha1(key: u8*, key_len: usize,
                  data: u8*, data_len: usize,
                  mac: u8*) {
    let a: u8*[1];
    let l: usize[1];
    a[0] = data;
    l[0] = data_len;
    wpa2_hmac_sha1_vec(key, key_len, 1, &a[0], &l[0], mac);
}

// ===========================================================================
// 2. PBKDF2-HMAC-SHA1 (RFC 2898 / IEEE 802.11i) & PRF-384
// ===========================================================================
fn pbkdf2_sha1_f(pass: u8*, pass_len: usize,
                 ssid: u8*, ssid_len: usize,
                 iterations: u32, count: u32, digest: u8*) {
    let cnt_be: u8[4];
    be32_store(&cnt_be[0], count);
    let a: u8*[2];
    let l: usize[2];
    a[0] = ssid;
    a[1] = &cnt_be[0];
    l[0] = ssid_len;
    l[1] = 4;

    let tmp: u8[20];
    wpa2_hmac_sha1_vec(pass, pass_len, 2, &a[0], &l[0], &tmp[0]);
    mem_copy(digest, &tmp[0], 20);

    let i: u32 = 1;
    while i < iterations {
        let tmp2: u8[20];
        wpa2_hmac_sha1(pass, pass_len, &tmp[0], 20, &tmp2[0]);
        mem_copy(&tmp[0], &tmp2[0], 20);
        let j: u32 = 0;
        while j < 20 {
            digest[j] = digest[j] ^ tmp[j];
            j = j + 1;
        }
        i = i + 1;
    }
}

@used
fn wpa2_pbkdf2_sha1(passphrase: char*, ssid: u8*, ssid_len: usize,
                    iterations: u32, buf: u8*, buflen: usize) {
    let pass_len: usize = str_len(passphrase);
    let count: u32 = 1;
    let pos: usize = 0;
    let left: usize = buflen;
    while left > 0 {
        let digest: u8[20];
        pbkdf2_sha1_f((u8*)passphrase, pass_len, ssid, ssid_len, iterations, count, &digest[0]);
        let take: usize = left;
        if take > 20 {
            take = 20;
        }
        mem_copy(&buf[pos], &digest[0], take);
        pos = pos + take;
        left = left - take;
        count = count + 1;
    }
}

@used
fn wpa2_prf_384(pmk: u8*, label: char*,
                data: u8*, data_len: usize,
                out: u8*) {
    let zero: u8 = 0;
    let counter: u8 = 0;
    let label_len: usize = str_len(label);
    let a: u8*[4];
    let l: usize[4];
    a[0] = (u8*)label;
    a[1] = &zero;
    a[2] = data;
    a[3] = &counter;
    l[0] = label_len;
    l[1] = 1;
    l[2] = data_len;
    l[3] = 1;

    let pos: usize = 0;
    while pos < 48 {
        let hash: u8[20];
        wpa2_hmac_sha1_vec(pmk, 32, 4, &a[0], &l[0], &hash[0]);
        let take: usize = 48 - pos;
        if take > 20 {
            take = 20;
        }
        mem_copy(&out[pos], &hash[0], take);
        pos = pos + take;
        counter = counter + (u8)1;
    }
}

// ===========================================================================
// 3. Compact AES-128 Decryption & RFC 3394 Key Unwrap (for GTK in EAPOL Msg 3)
// ===========================================================================
