    0x17,0x2b,0x04,0x7e,0xba,0x77,0xd6,0x26,0xe1,0x69,0x14,0x63,0x55,0x21,0x0c,0x7d
];

let s_aes_rcon: u8[10] = [
    0x01,0x02,0x04,0x08,0x10,0x20,0x40,0x80,0x1b,0x36
];

@inline
fn gf_xtime(x: u8) -> u8 {
    let hi: u8 = 0;
    if (x & 0x80) != 0 {
        hi = (u8)0x1B;
    }
    return (u8)(((u32)x << 1) ^ (u32)hi);
}

fn gf_mul(a_in: u8, b_in: u8) -> u8 {
    let a: u8 = a_in;
    let b: u8 = b_in;
    let res: u8 = 0;
    while b != 0 {
        if (b & 1) != 0 {
            res = res ^ a;
        }
        a = gf_xtime(a);
        b = b >> 1;
    }
    return res;
}

fn aes128_key_expand(key: u8*, rk: u8*) {
    mem_copy(rk, key, 16);
    let i: u32 = 4;
    while i < 44 {
        let t: u8[4];
        mem_copy(&t[0], &rk[(i - 1) * 4], 4);
        if (i & 3) == 0 {
            let tmp: u8 = t[0];
            t[0] = s_aes_sbox[t[1]] ^ s_aes_rcon[(i / 4) - 1];
            t[1] = s_aes_sbox[t[2]];
            t[2] = s_aes_sbox[t[3]];
            t[3] = s_aes_sbox[tmp];
        }
        let j: u32 = 0;
        while j < 4 {
            rk[i * 4 + j] = rk[(i - 4) * 4 + j] ^ t[j];
            j = j + 1;
        }
        i = i + 1;
    }
}

fn aes128_decrypt_block(rk: u8*, inp: u8*, outp: u8*) {
    let s: u8[16];
    let i: u32 = 0;
    while i < 16 {
        s[i] = inp[i] ^ rk[160 + i];
        i = i + 1;
    }

    let round: i32 = 9;
    while round >= 0 {
        // InvShiftRows
        let t: u8 = s[13];
        s[13] = s[9];  s[9]  = s[5];  s[5]  = s[1];  s[1]  = t;
        t = s[2];  s[2]  = s[10]; s[10] = t;
        t = s[6];  s[6]  = s[14]; s[14] = t;
        t = s[3];  s[3]  = s[7];  s[7]  = s[11]; s[11] = s[15]; s[15] = t;

        // InvSubBytes + AddRoundKey
        let r_off: u32 = (u32)round * 16;
        i = 0;
        while i < 16 {
            s[i] = s_aes_rsbox[s[i]] ^ rk[r_off + i];
            i = i + 1;
        }

        // InvMixColumns (skip on final round 0)
        if round > 0 {
            let c: u32 = 0;
            while c < 4 {
                let a0: u8 = s[c * 4 + 0];
                let a1: u8 = s[c * 4 + 1];
                let a2: u8 = s[c * 4 + 2];
                let a3: u8 = s[c * 4 + 3];
                s[c * 4 + 0] = gf_mul(a0, (u8)14) ^ gf_mul(a1, (u8)11) ^ gf_mul(a2, (u8)13) ^ gf_mul(a3, (u8)9);
                s[c * 4 + 1] = gf_mul(a0, (u8)9)  ^ gf_mul(a1, (u8)14) ^ gf_mul(a2, (u8)11) ^ gf_mul(a3, (u8)13);
                s[c * 4 + 2] = gf_mul(a0, (u8)13) ^ gf_mul(a1, (u8)9)  ^ gf_mul(a2, (u8)14) ^ gf_mul(a3, (u8)11);
                s[c * 4 + 3] = gf_mul(a0, (u8)11) ^ gf_mul(a1, (u8)13) ^ gf_mul(a2, (u8)9)  ^ gf_mul(a3, (u8)14);
                c = c + 1;
            }
        }
        round = round - 1;
    }
    mem_copy(outp, &s[0], 16);
}

@used
fn wpa2_aes_unwrap(kek: u8*, n_blocks: usize, cipher: u8*, plain: u8*) -> i32 {
    if n_blocks == 0 || cipher == (u8*)0 || plain == (u8*)0 {
        return -1;
    }
    let rk: u8[176];
    aes128_key_expand(kek, &rk[0]);

    let a: u8[8];
    mem_copy(&a[0], cipher, 8);
    mem_copy(plain, &cipher[8], n_blocks * 8);

    let j: i32 = 5;
    while j >= 0 {
        let i: i32 = (i32)n_blocks;
        while i >= 1 {
            let t: u64 = (u64)n_blocks * (u64)j + (u64)i;
            let b: u8[16];
            mem_copy(&b[0], &a[0], 8);
            b[7] = b[7] ^ (u8)(t & 0xFF);
            b[6] = b[6] ^ (u8)((t >> 8) & 0xFF);
            b[5] = b[5] ^ (u8)((t >> 16) & 0xFF);
            b[4] = b[4] ^ (u8)((t >> 24) & 0xFF);
            let off: usize = (usize)(i - 1) * 8;
            mem_copy(&b[8], &plain[off], 8);
            aes128_decrypt_block(&rk[0], &b[0], &b[0]);
            mem_copy(&a[0], &b[0], 8);
            mem_copy(&plain[off], &b[8], 8);
            i = i - 1;
        }
        j = j - 1;
    }

    let k: u32 = 0;
    while k < 8 {
        if a[k] != 0xA6 {
            return -1;
        }
        k = k + 1;
    }
    return 0;
}
