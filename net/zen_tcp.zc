// ZenTCP: Freestanding RFC 793 TCP Client & HTTP/1.1 Stack in Zen-C
// Runs directly atop net/zen_net.zc IPv4 with zero external dependencies.
// Supports 2 concurrent TCP sockets, 3-way handshake, MSS negotiation,
// retransmission timer, 2 KB circular RX ring buffer, clean FIN teardown,
// and a built-in HTTP/1.1 GET client.

import "rtos.h" as rtos;

// ZenNet IPv4 & DNS hooks
extern fn zen_net_is_up() -> bool;
extern fn zen_net_get_ip() -> u32;
extern fn zen_net_ip4_send(dst_ip: u32, proto: u8, payload: u8*, payload_len: u16) -> i32;
extern fn zen_dns_resolve(host: char*, out_ip: u32*, timeout_ms: u32) -> bool;

// Constants
def TCP_IP_PROTO: u8        = 6;
def TCP_MAX_SOCKETS: u32    = 2;
def TCP_RX_RING_CAP: usize  = 2048;
def TCP_TX_SEG_MAX: usize   = 512;

def TCP_STATE_CLOSED: u32      = 0;
def TCP_STATE_SYN_SENT: u32    = 1;
def TCP_STATE_ESTABLISHED: u32 = 2;
def TCP_STATE_FIN_WAIT: u32    = 3;
def TCP_STATE_CLOSE_WAIT: u32  = 4;

def TCP_FLAG_FIN: u8        = 0x01;
def TCP_FLAG_SYN: u8        = 0x02;
def TCP_FLAG_RST: u8        = 0x04;
def TCP_FLAG_PSH: u8        = 0x08;
def TCP_FLAG_ACK: u8        = 0x10;

struct TcpSocket {
    state: u32;
    local_port: u16;
    remote_port: u16;
    remote_ip: u32;
    snd_una: u32;
    snd_nxt: u32;
    rcv_nxt: u32;
    peer_fin: bool;
    rst_rcvd: bool;
    // Circular RX buffer
    rx_head: usize;
    rx_tail: usize;
    rx_count: usize;
    rx_buf: u8[2048];
    // Retransmit state for current unacked segment
    rtx_active: bool;
    rtx_flags: u8;
    rtx_seq: u32;
    rtx_len: u16;
    rtx_last_ms: u32;
    rtx_retries: u32;
    rtx_buf: u8[512];
    ev_sem: rtos::rtos_sem_t;
}

let g_tcp_inited: bool = false;
let g_tcp_socks: TcpSocket[2];
let g_tcp_ephemeral: u16 = 50000;
let g_tcp_isn_seed: u32  = 0x13572468;
let g_tcp_tx_buf: u8[560];
let g_http_req_buf: u8[256];

@inline
fn tcp_rd_be16(p: u8*) -> u16 {
    return ((u16)p[0] << 8) | (u16)p[1];
}

@inline
fn tcp_rd_be32(p: u8*) -> u32 {
    return ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | (u32)p[3];
}

@inline
fn tcp_wr_be16(p: u8*, v: u16) {
    p[0] = (u8)(v >> 8);
    p[1] = (u8)(v & 0xFF);
}

@inline
fn tcp_wr_be32(p: u8*, v: u32) {
    p[0] = (u8)(v >> 24);
    p[1] = (u8)((v >> 16) & 0xFF);
    p[2] = (u8)((v >> 8) & 0xFF);
    p[3] = (u8)(v & 0xFF);
}

fn tcp_checksum(src_ip: u32, dst_ip: u32, seg: u8*, seg_len: usize) -> u16 {
    let sum: u32 = 0;
    sum = sum + ((src_ip >> 16) & 0xFFFF) + (src_ip & 0xFFFF);
    sum = sum + ((dst_ip >> 16) & 0xFFFF) + (dst_ip & 0xFFFF);
    sum = sum + (u32)TCP_IP_PROTO + (u32)seg_len;

    let i: usize = 0;
    while i + 1 < seg_len {
        sum = sum + (((u32)seg[i] << 8) | (u32)seg[i + 1]);
        i = i + 2;
    }
    if i < seg_len {
        sum = sum + ((u32)seg[i] << 8);
    }
    while (sum >> 16) != 0 {
        sum = (sum & 0xFFFF) + (sum >> 16);
    }
    return (u16)((~sum) & 0xFFFF);
}

fn tcp_send_segment(dst_ip: u32, src_port: u16, dst_port: u16,
                    seq: u32, ack: u32, flags: u8, win: u16,
                    payload: u8*, plen: u16) -> i32 {
    let hdr_len: usize = 20;
    let is_syn: bool = (flags & TCP_FLAG_SYN) != 0;
    if is_syn {
        hdr_len = 24; // Include 4-byte MSS option (1360 bytes)
    }
    let total_len: usize = hdr_len + (usize)plen;
    if total_len > 560 {
        return -1;
    }

    let i: usize = 0;
    while i < hdr_len {
        g_tcp_tx_buf[i] = (u8)0;
        i = i + 1;
    }

    tcp_wr_be16(&g_tcp_tx_buf[0], src_port);
    tcp_wr_be16(&g_tcp_tx_buf[2], dst_port);
    tcp_wr_be32(&g_tcp_tx_buf[4], seq);
    tcp_wr_be32(&g_tcp_tx_buf[8], ack);
    g_tcp_tx_buf[12] = (u8)((hdr_len / 4) << 4);
    g_tcp_tx_buf[13] = flags;
    tcp_wr_be16(&g_tcp_tx_buf[14], win);

    if is_syn {
        // MSS option: Kind=2, Len=4, MSS=1360 (0x0550)
        g_tcp_tx_buf[20] = (u8)2;
        g_tcp_tx_buf[21] = (u8)4;
        tcp_wr_be16(&g_tcp_tx_buf[22], (u16)1360);
    }

    if plen > 0 && payload != (u8*)0 {
        i = 0;
        while i < (usize)plen {
            g_tcp_tx_buf[hdr_len + i] = payload[i];
            i = i + 1;
        }
    }

    let csum: u16 = tcp_checksum(zen_net_get_ip(), dst_ip, &g_tcp_tx_buf[0], total_len);
    tcp_wr_be16(&g_tcp_tx_buf[16], csum);

    return zen_net_ip4_send(dst_ip, TCP_IP_PROTO, &g_tcp_tx_buf[0], (u16)total_len);
}

fn tcp_rx_window(idx: u32) -> u16 {
    let avail: usize = TCP_RX_RING_CAP - g_tcp_socks[idx].rx_count;
    return (u16)avail;
}

@used
fn zen_tcp_init() {
    let i: u32 = 0;
    while i < TCP_MAX_SOCKETS {
        g_tcp_socks[i].state      = TCP_STATE_CLOSED;
        g_tcp_socks[i].rx_head    = 0;
        g_tcp_socks[i].rx_tail    = 0;
        g_tcp_socks[i].rx_count   = 0;
        g_tcp_socks[i].rtx_active = false;
        g_tcp_socks[i].peer_fin   = false;
        g_tcp_socks[i].rst_rcvd   = false;
        rtos::rtos_sem_init(&g_tcp_socks[i].ev_sem, 0, 1);
        i = i + 1;
    }
    g_tcp_inited = true;
}

@used
fn zen_tcp_rx_ip4(src_ip: u32, payload: u8*, len: usize) {
    if !g_tcp_inited || payload == (u8*)0 || len < 20 {
        return;
    }
    let data_off: usize = (usize)((payload[12] >> 4) & 0x0F) * 4;
    if data_off < 20 || data_off > len {
        return;
    }
    if tcp_checksum(src_ip, zen_net_get_ip(), payload, len) != 0 {
        return;
    }

    let src_port: u16 = tcp_rd_be16(&payload[0]);
    let dst_port: u16 = tcp_rd_be16(&payload[2]);
    let seg_seq: u32  = tcp_rd_be32(&payload[4]);
    let seg_ack: u32  = tcp_rd_be32(&payload[8]);
    let flags: u8     = payload[13];
    let seg_data: u8* = &payload[data_off];
    let seg_dlen: usize = len - data_off;

    // Locate matching socket
    let idx: i32 = -1;
    let i: u32 = 0;
    while i < TCP_MAX_SOCKETS {
        if g_tcp_socks[i].state != TCP_STATE_CLOSED &&
           g_tcp_socks[i].local_port == dst_port &&
           g_tcp_socks[i].remote_port == src_port &&
           g_tcp_socks[i].remote_ip == src_ip {
            idx = (i32)i;
            break;
        }
        i = i + 1;
    }
    if idx < 0 {
        // Reply RST for non-RST traffic to closed ports
        if (flags & TCP_FLAG_RST) == 0 {
            let rst_seq: u32 = 0;
            if (flags & TCP_FLAG_ACK) != 0 {
                rst_seq = seg_ack;
            }
            let _rc: i32 = tcp_send_segment(src_ip, dst_port, src_port, rst_seq, 0, TCP_FLAG_RST, (u16)0, (u8*)0, (u16)0);
        }
        return;
    }

    let s: u32 = (u32)idx;
    if (flags & TCP_FLAG_RST) != 0 {
        g_tcp_socks[s].rst_rcvd   = true;
        g_tcp_socks[s].rtx_active = false;
        g_tcp_socks[s].state      = TCP_STATE_CLOSED;
        rtos::rtos_sem_signal(&g_tcp_socks[s].ev_sem);
        return;
    }

    // 1. SYN_SENT -> expecting SYN+ACK
    if g_tcp_socks[s].state == TCP_STATE_SYN_SENT {
        if (flags & (TCP_FLAG_SYN | TCP_FLAG_ACK)) == (TCP_FLAG_SYN | TCP_FLAG_ACK) &&
           seg_ack == g_tcp_socks[s].snd_nxt {
            g_tcp_socks[s].snd_una    = seg_ack;
            g_tcp_socks[s].rcv_nxt    = seg_seq + 1;
            g_tcp_socks[s].rtx_active = false;
            g_tcp_socks[s].state      = TCP_STATE_ESTABLISHED;
            let _rc: i32 = tcp_send_segment(src_ip, dst_port, src_port,
                                            g_tcp_socks[s].snd_nxt, g_tcp_socks[s].rcv_nxt,
                                            TCP_FLAG_ACK, tcp_rx_window(s), (u8*)0, (u16)0);
            rtos::rtos_sem_signal(&g_tcp_socks[s].ev_sem);
        }
        return;
    }

    // 2. ESTABLISHED / FIN_WAIT / CLOSE_WAIT
    let notify: bool = false;
    if (flags & TCP_FLAG_ACK) != 0 {
        if (i32)(seg_ack - g_tcp_socks[s].snd_una) > 0 &&
           (i32)(g_tcp_socks[s].snd_nxt - seg_ack) >= 0 {
            g_tcp_socks[s].snd_una = seg_ack;
            if g_tcp_socks[s].snd_una == g_tcp_socks[s].snd_nxt {
                g_tcp_socks[s].rtx_active = false;
                notify = true;
            }
        }
    }

    let need_ack: bool = false;
    if seg_dlen > 0 {
        if seg_seq == g_tcp_socks[s].rcv_nxt {
            let space: usize = TCP_RX_RING_CAP - g_tcp_socks[s].rx_count;
            let take: usize = seg_dlen;
            if take > space {
                take = space;
            }
            let k: usize = 0;
            while k < take {
                g_tcp_socks[s].rx_buf[g_tcp_socks[s].rx_head] = seg_data[k];
                g_tcp_socks[s].rx_head = (g_tcp_socks[s].rx_head + 1) % TCP_RX_RING_CAP;
                k = k + 1;
            }
            g_tcp_socks[s].rx_count = g_tcp_socks[s].rx_count + take;
            g_tcp_socks[s].rcv_nxt  = g_tcp_socks[s].rcv_nxt + (u32)take;
            need_ack = true;
            notify   = true;
        } else {
            // Out-of-order / duplicate segment -> re-ACK our expected rcv_nxt
            need_ack = true;
        }
    }

    if (flags & TCP_FLAG_FIN) != 0 && (seg_seq + (u32)seg_dlen) == g_tcp_socks[s].rcv_nxt {
        g_tcp_socks[s].rcv_nxt  = g_tcp_socks[s].rcv_nxt + 1;
        g_tcp_socks[s].peer_fin = true;
        need_ack = true;
        notify   = true;
        if g_tcp_socks[s].state == TCP_STATE_ESTABLISHED {
            g_tcp_socks[s].state = TCP_STATE_CLOSE_WAIT;
        } else if g_tcp_socks[s].state == TCP_STATE_FIN_WAIT {
            g_tcp_socks[s].state = TCP_STATE_CLOSED;
        }
    }

    if need_ack {
        let _rc: i32 = tcp_send_segment(src_ip, dst_port, src_port,
                                        g_tcp_socks[s].snd_nxt, g_tcp_socks[s].rcv_nxt,
                                        TCP_FLAG_ACK, tcp_rx_window(s), (u8*)0, (u16)0);
    }

    if notify {
        rtos::rtos_sem_signal(&g_tcp_socks[s].ev_sem);
    }
}

@used
fn zen_tcp_tick(now_ms: u32) {
    if !g_tcp_inited {
        return;
    }
    let i: u32 = 0;
    while i < TCP_MAX_SOCKETS {
        if g_tcp_socks[i].state != TCP_STATE_CLOSED && g_tcp_socks[i].rtx_active {
            if (now_ms - g_tcp_socks[i].rtx_last_ms) >= 600 {
                if g_tcp_socks[i].rtx_retries >= 5 {
                    g_tcp_socks[i].rtx_active = false;
                    g_tcp_socks[i].rst_rcvd   = true;
                    g_tcp_socks[i].state      = TCP_STATE_CLOSED;
                    rtos::rtos_sem_signal(&g_tcp_socks[i].ev_sem);
                } else {
                    g_tcp_socks[i].rtx_retries = g_tcp_socks[i].rtx_retries + 1;
                    g_tcp_socks[i].rtx_last_ms = now_ms;
                    let _rc: i32 = tcp_send_segment(
                        g_tcp_socks[i].remote_ip,
                        g_tcp_socks[i].local_port,
                        g_tcp_socks[i].remote_port,
                        g_tcp_socks[i].rtx_seq,
                        g_tcp_socks[i].rcv_nxt,
                        g_tcp_socks[i].rtx_flags,
                        tcp_rx_window(i),
                        &g_tcp_socks[i].rtx_buf[0],
                        g_tcp_socks[i].rtx_len
                    );
                }
            }
        }
        i = i + 1;
    }
}

@used
fn zen_tcp_connect(dst_ip: u32, dst_port: u16, timeout_ms: u32) -> i32 {
    if !g_tcp_inited || !zen_net_is_up() || dst_ip == 0 || dst_port == 0 {
        return -1;
    }

    let slot: i32 = -1;
    let i: u32 = 0;
    while i < TCP_MAX_SOCKETS {
        if g_tcp_socks[i].state == TCP_STATE_CLOSED {
            slot = (i32)i;
            break;
        }
        i = i + 1;
    }
    if slot < 0 {
        return -1;
    }

    let s: u32 = (u32)slot;
    let lport: u16 = g_tcp_ephemeral;
    g_tcp_ephemeral = g_tcp_ephemeral + (u16)1;
    if g_tcp_ephemeral < 50000 {
        g_tcp_ephemeral = (u16)50000;
    }
    let isn: u32 = g_tcp_isn_seed + rtos::rtos_get_tick() * 251;
    g_tcp_isn_seed = g_tcp_isn_seed + 64000;

    g_tcp_socks[s].local_port  = lport;
    g_tcp_socks[s].remote_port = dst_port;
    g_tcp_socks[s].remote_ip   = dst_ip;
    g_tcp_socks[s].snd_una     = isn;
    g_tcp_socks[s].snd_nxt     = isn + 1;
    g_tcp_socks[s].rcv_nxt     = 0;
    g_tcp_socks[s].rx_head     = 0;
    g_tcp_socks[s].rx_tail     = 0;
    g_tcp_socks[s].rx_count    = 0;
    g_tcp_socks[s].peer_fin    = false;
    g_tcp_socks[s].rst_rcvd    = false;
    g_tcp_socks[s].state       = TCP_STATE_SYN_SENT;
    g_tcp_socks[s].rtx_active  = true;
    g_tcp_socks[s].rtx_flags   = TCP_FLAG_SYN;
    g_tcp_socks[s].rtx_seq     = isn;
    g_tcp_socks[s].rtx_len     = (u16)0;
    g_tcp_socks[s].rtx_last_ms = rtos::rtos_get_tick();
    g_tcp_socks[s].rtx_retries = 0;
    let _dr: bool = rtos::rtos_sem_wait(&g_tcp_socks[s].ev_sem, 0);

    let _rc: i32 = tcp_send_segment(dst_ip, lport, dst_port, isn, 0, TCP_FLAG_SYN, tcp_rx_window(s), (u8*)0, (u16)0);

    let deadline: u32 = rtos::rtos_get_tick() + timeout_ms;
    while g_tcp_socks[s].state == TCP_STATE_SYN_SENT {
        let now: u32 = rtos::rtos_get_tick();
        if (i32)(deadline - now) <= 0 {
            break;
        }
        let rem: u32 = deadline - now;
        let _ok: bool = rtos::rtos_sem_wait(&g_tcp_socks[s].ev_sem, rem);
    }

    if g_tcp_socks[s].state != TCP_STATE_ESTABLISHED {
        g_tcp_socks[s].rtx_active = false;
        g_tcp_socks[s].state      = TCP_STATE_CLOSED;
        return -1;
    }
    return slot;
}

@used
fn zen_tcp_send(slot: i32, data: u8*, len: u16, timeout_ms: u32) -> i32 {
    if slot < 0 || (u32)slot >= TCP_MAX_SOCKETS || data == (u8*)0 {
        return -1;
    }
    let s: u32 = (u32)slot;
    if g_tcp_socks[s].state != TCP_STATE_ESTABLISHED && g_tcp_socks[s].state != TCP_STATE_CLOSE_WAIT {
        return -1;
    }

    let sent: usize = 0;
    let total: usize = (usize)len;
    while sent < total {
        let chunk: usize = total - sent;
        if chunk > TCP_TX_SEG_MAX {
            chunk = TCP_TX_SEG_MAX;
        }
        let k: usize = 0;
        while k < chunk {
            g_tcp_socks[s].rtx_buf[k] = data[sent + k];
            k = k + 1;
        }
        let seq: u32 = g_tcp_socks[s].snd_nxt;
        g_tcp_socks[s].snd_nxt     = seq + (u32)chunk;
        g_tcp_socks[s].rtx_active  = true;
        g_tcp_socks[s].rtx_flags   = TCP_FLAG_PSH | TCP_FLAG_ACK;
        g_tcp_socks[s].rtx_seq     = seq;
        g_tcp_socks[s].rtx_len     = (u16)chunk;
        g_tcp_socks[s].rtx_last_ms = rtos::rtos_get_tick();
        g_tcp_socks[s].rtx_retries = 0;

        let _rc: i32 = tcp_send_segment(
            g_tcp_socks[s].remote_ip, g_tcp_socks[s].local_port, g_tcp_socks[s].remote_port,
            seq, g_tcp_socks[s].rcv_nxt, TCP_FLAG_PSH | TCP_FLAG_ACK,
            tcp_rx_window(s), &g_tcp_socks[s].rtx_buf[0], (u16)chunk
        );

        // Wait for ACK of this segment (or skip wait if timeout_ms == 0)
        if timeout_ms > 0 {
            let deadline: u32 = rtos::rtos_get_tick() + timeout_ms;
            while g_tcp_socks[s].snd_una != g_tcp_socks[s].snd_nxt && !g_tcp_socks[s].rst_rcvd {
                let now: u32 = rtos::rtos_get_tick();
                if (i32)(deadline - now) <= 0 {
                    return -1;
                }
                let _ok: bool = rtos::rtos_sem_wait(&g_tcp_socks[s].ev_sem, deadline - now);
            }
            if g_tcp_socks[s].rst_rcvd {
                return -1;
            }
        }
        sent = sent + chunk;
    }
    return (i32)sent;
}

@used
fn zen_tcp_recv(slot: i32, buf: u8*, cap: u16, timeout_ms: u32) -> i32 {
    if slot < 0 || (u32)slot >= TCP_MAX_SOCKETS || buf == (u8*)0 || cap == 0 {
        return -1;
    }
    let s: u32 = (u32)slot;
    let deadline: u32 = rtos::rtos_get_tick() + timeout_ms;

    while g_tcp_socks[s].rx_count == 0 {
        if g_tcp_socks[s].peer_fin || g_tcp_socks[s].state == TCP_STATE_CLOSED {
            return 0; // Clean EOF
        }
        if g_tcp_socks[s].rst_rcvd {
            return -1;
        }
        let now: u32 = rtos::rtos_get_tick();
        if (i32)(deadline - now) <= 0 {
            return -1; // Timeout
        }
        let _ok: bool = rtos::rtos_sem_wait(&g_tcp_socks[s].ev_sem, deadline - now);
    }

    let flags: u32 = rtos::rtos_irq_save();
    let take: usize = g_tcp_socks[s].rx_count;
    if take > (usize)cap {
        take = (usize)cap;
    }
    let k: usize = 0;
    while k < take {
        buf[k] = g_tcp_socks[s].rx_buf[g_tcp_socks[s].rx_tail];
        g_tcp_socks[s].rx_tail = (g_tcp_socks[s].rx_tail + 1) % TCP_RX_RING_CAP;
        k = k + 1;
    }
    g_tcp_socks[s].rx_count = g_tcp_socks[s].rx_count - take;
    rtos::rtos_irq_restore(flags);
    return (i32)take;
}

@used
fn zen_tcp_close(slot: i32) {
    if slot < 0 || (u32)slot >= TCP_MAX_SOCKETS {
        return;
    }
    let s: u32 = (u32)slot;
    if g_tcp_socks[s].state == TCP_STATE_ESTABLISHED || g_tcp_socks[s].state == TCP_STATE_CLOSE_WAIT {
        let seq: u32 = g_tcp_socks[s].snd_nxt;
        g_tcp_socks[s].snd_nxt    = seq + 1;
        g_tcp_socks[s].rtx_active = false;
        g_tcp_socks[s].state      = TCP_STATE_FIN_WAIT;
        let _rc: i32 = tcp_send_segment(
            g_tcp_socks[s].remote_ip, g_tcp_socks[s].local_port, g_tcp_socks[s].remote_port,
            seq, g_tcp_socks[s].rcv_nxt, TCP_FLAG_FIN | TCP_FLAG_ACK,
            tcp_rx_window(s), (u8*)0, (u16)0
        );
        let _ok: bool = rtos::rtos_sem_wait(&g_tcp_socks[s].ev_sem, 200);
    }
    g_tcp_socks[s].rtx_active = false;
    g_tcp_socks[s].state      = TCP_STATE_CLOSED;
}

@used
fn zen_tcp_slot_state(slot: i32) -> u32 {
    if slot >= 0 && (u32)slot < TCP_MAX_SOCKETS {
        return g_tcp_socks[slot].state;
    }
    return TCP_STATE_CLOSED;
}

@used
fn zen_tcp_slot_local_port(slot: i32) -> u16 {
    if slot >= 0 && (u32)slot < TCP_MAX_SOCKETS && g_tcp_socks[slot].state != TCP_STATE_CLOSED {
        return g_tcp_socks[slot].local_port;
    }
    return (u16)0;
}

@used
fn zen_tcp_slot_remote_port(slot: i32) -> u16 {
    if slot >= 0 && (u32)slot < TCP_MAX_SOCKETS && g_tcp_socks[slot].state != TCP_STATE_CLOSED {
        return g_tcp_socks[slot].remote_port;
    }
    return (u16)0;
}

// ===========================================================================
// HTTP/1.1 GET Client Helper
// ===========================================================================
fn append_str(dst: u8*, pos: usize, cap: usize, s: char*) -> usize {
    let p: usize = pos;
    let i: usize = 0;
    while s[i] != '\0' && p < cap {
        dst[p] = (u8)s[i];
        p = p + 1;
        i = i + 1;
    }
    return p;
}

@used
fn zen_http_get(host: char*, port: u16, path: char*,
                out_buf: u8*, cap: u16, timeout_ms: u32) -> i32 {
    if host == (char*)0 || out_buf == (u8*)0 || cap < 2 {
        return -1;
    }
    let ip: u32 = 0;
    if !zen_dns_resolve(host, &ip, timeout_ms) {
        return -2;
    }
    let use_port: u16 = port;
    if use_port == 0 {
        use_port = (u16)80;
    }
    let use_path: char* = path;
    if use_path == (char*)0 || use_path[0] == '\0' {
        use_path = "/";
    }

    let slot: i32 = zen_tcp_connect(ip, use_port, timeout_ms);
    if slot < 0 {
        return -3;
    }

    let pos: usize = 0;
    pos = append_str(&g_http_req_buf[0], pos, 255, "GET ");
    pos = append_str(&g_http_req_buf[0], pos, 255, use_path);
    pos = append_str(&g_http_req_buf[0], pos, 255, " HTTP/1.1\r\nHost: ");
    pos = append_str(&g_http_req_buf[0], pos, 255, host);
    pos = append_str(&g_http_req_buf[0], pos, 255, "\r\nUser-Agent: ZenRTOS/1.0\r\nConnection: close\r\n\r\n");

    if zen_tcp_send(slot, &g_http_req_buf[0], (u16)pos, timeout_ms) < 0 {
        zen_tcp_close(slot);
        return -4;
    }

    let total: usize = 0;
    let max_read: usize = (usize)cap - 1;
    while total < max_read {
        let n: i32 = zen_tcp_recv(slot, &out_buf[total], (u16)(max_read - total), timeout_ms);
        if n <= 0 {
            break;
        }
        total = total + (usize)n;
    }
    out_buf[total] = (u8)0;
    zen_tcp_close(slot);
    return (i32)total;
}
